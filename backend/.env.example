# AWS & Bedrock Configuration (SORTIA)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Optional if not using `aws configure` / IAM role:
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional S3 bucket for large file previews in AWS mode:
SORTIA_S3_BUCKET=
